{
    "name": "tessera/tessera-exports",
    "description": "The Exports module of Tessera.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "tessera/tessera-engine": "^3.0",
        "tessera/tessera-tenant": "^3.0",
        "mpdf/mpdf": "*",
        "openspout/openspout": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Exports\\": ""
        }
    },
    "extra": {
        "tessera": {
            "modules": [
                "App\\Modules\\Exports\\ExportsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    },
    "replace": {
        "ahmad-chebbo/tessera-exports": "self.version"
    }
}
